{
  "providers": {
    "digitalocean": {
      "token_ref": "op://<vault>/<item>/credential"
    },
    "forge": {
      "token_ref": "op://<vault>/<item>/credential",
      "organization": "<organization-slug>"
    },
    "cloud": {
      "cli_config": "~/.config/cloud/config.json",
      "token_ref": "op://<vault>/<item>/credential"
    },
    "openprovider": {
      "username_ref": "op://<vault>/<item>/username",
      "password_ref": "op://<vault>/<item>/password"
    }
  }
}
