#!/bin/bash
#
# Standalone Claude Code installation script
# Can be run independently or as part of full dotfiles setup

set -e

# Colors
BLUE='\033[0;34m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

step() { echo ""; echo -e "${BLUE}➜${NC} $1"; }
success() { echo -e "${GREEN}✓${NC} $1"; }
warn() { echo -e "${YELLOW}⚠${NC} $1"; }
error() { echo -e "${RED}✗${NC} $1"; exit 1; }

echo ""
echo "Claude Code Installation"
echo "========================"
echo ""

# Install Claude Code
step "Installing Claude Code CLI"
if command -v claude &>/dev/null; then
    warn "Claude Code already installed"
else
    # Try Homebrew first (modern)
    if command -v brew &>/dev/null; then
        brew install --cask claude-code || warn "Claude Code installation failed"
    else
        # Fallback to curl installer
        warn "Homebrew not found, using curl installer"
        curl -fsSL https://claude.ai/install.sh | bash || warn "Claude Code installation failed"
    fi
fi
success "Claude Code processed"

# Check if running from dotfiles repo
DOTFILES_DIR="$HOME/.dotfiles"
if [ ! -d "$DOTFILES_DIR" ]; then
    # Try to detect if script is in a dotfiles directory
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    if [ -f "$SCRIPT_DIR/../config/claude/AGENTS.md" ]; then
        DOTFILES_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
    fi
fi

# Claude configuration
if [ -d "$DOTFILES_DIR/config/claude" ]; then
    step "Setting up Claude Code configuration"
    mkdir -p ~/.claude

    # Symlink configuration files
    # Claude Code reads CLAUDE.md, not AGENTS.md, so it gets a symlink under the
    # name it expects. Codex reads AGENTS.md directly. One file, both harnesses.
    ln -sf "$DOTFILES_DIR/config/claude/AGENTS.md" ~/.claude/CLAUDE.md
    ln -sf "$DOTFILES_DIR/config/claude/settings.json" ~/.claude/settings.json
    ln -sf "$DOTFILES_DIR/config/claude/statusline.sh" ~/.claude/statusline.sh

    # Symlink entire skills directory
    rm -rf ~/.claude/skills
    ln -sf "$DOTFILES_DIR/config/claude/skills" ~/.claude/skills

    # Symlink entire agents directory
    rm -rf ~/.claude/agents
    ln -sf "$DOTFILES_DIR/config/claude/agents" ~/.claude/agents

    # The music workspace is a plain directory, not a repo, so nothing else
    # version controls the enablement of the music@skills-dir plugin.
    MUSIC_DIR="$HOME/dev/code/music"
    mkdir -p "$MUSIC_DIR/.claude"
    if [ ! -f "$MUSIC_DIR/.claude/settings.json" ]; then
        cat > "$MUSIC_DIR/.claude/settings.json" <<'JSON'
{
  "enabledPlugins": {
    "music@skills-dir": true
  }
}
JSON
    fi

    # Share the harness-neutral skills with Codex and any other SKILL.md reader.
    if [ -x "$DOTFILES_DIR/bin/link-agent-skills" ]; then
        DOTFILES_DIR="$DOTFILES_DIR" "$DOTFILES_DIR/bin/link-agent-skills"
    fi

    success "Claude Code configured"
else
    warn "Dotfiles directory not found, skipping configuration"
    echo "  To set up configuration later, clone dotfiles to ~/.dotfiles"
fi

# Agent Skills (included in dotfiles)
# All skills are version-controlled in config/claude/skills/
# No need to install them - they're symlinked from the dotfiles repo

# Done
echo ""
success "Claude Code setup complete!"
echo ""
step "Next steps:"
if [ ! -d "$DOTFILES_DIR/config/claude" ]; then
    echo "  • Clone dotfiles for custom configuration:"
    echo "    git clone https://github.com/freekmurze/dotfiles.git ~/.dotfiles"
    echo "    ~/.dotfiles/bin/install-claude-code"
    echo ""
fi
echo "  • Start using: claude"
echo "  • Discover more skills: https://skills.sh"
echo ""
