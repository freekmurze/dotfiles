#!/bin/bash
#
# Format edited PHP files with Pint, without ever reformatting code the change
# did not touch.
#
# Pint rewrites a whole file, not the lines you edited. In a codebase that is
# not already Pint clean, formatting a file after a one line edit rewrites
# everything else in it too, and the diff fills up with changes nobody made.
#
# So this runs in two parts. Before the edit it records whether the file was
# already Pint clean. After the edit it only formats files that were clean, or
# that did not exist yet. A file that was already dirty is left alone: Pint
# would have nothing to fix in the new code that it would not also "fix"
# everywhere else.
#
# Usage, from a Claude Code hook, with the hook JSON on stdin:
#   claude-pint-hook pre
#   claude-pint-hook post

set -u

MODE="${1:-post}"
MARKER_DIR="${TMPDIR:-/tmp}/claude-pint-skip"

file=$(jq -r '.tool_input.file_path // empty' 2>/dev/null)
[ -n "$file" ] || exit 0
case "$file" in
    *.php) ;;
    *) exit 0 ;;
esac

# Blade templates are PHP files by extension, but Pint leaves them alone.
# Skip them explicitly so intent is obvious rather than incidental.
case "$file" in
    *.blade.php) exit 0 ;;
esac

# Walk up to the nearest project that has Pint installed.
root=""
dir=$(dirname "$file")
while [ "$dir" != "/" ] && [ -n "$dir" ]; do
    if [ -x "$dir/vendor/bin/pint" ]; then
        root="$dir"
        break
    fi
    dir=$(dirname "$dir")
done
[ -n "$root" ] || exit 0

marker="$MARKER_DIR/$(printf '%s' "$file" | shasum | cut -d' ' -f1)"

if [ "$MODE" = "pre" ]; then
    # A file that does not exist yet is new, and formatting it in full is right.
    [ -f "$file" ] || exit 0

    mkdir -p "$MARKER_DIR"
    if ! (cd "$root" && ./vendor/bin/pint --test "$file" >/dev/null 2>&1); then
        # Already not Pint clean. Formatting it later would rewrite untouched code.
        : > "$marker"
    else
        rm -f "$marker"
    fi
    exit 0
fi

if [ -f "$marker" ]; then
    rm -f "$marker"
    exit 0
fi

[ -f "$file" ] || exit 0
(cd "$root" && ./vendor/bin/pint --quiet "$file" >/dev/null 2>&1)
exit 0
